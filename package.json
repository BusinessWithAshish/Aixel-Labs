{
    "name": "aixellabs",
    "private": true,
    "packageManager": "pnpm@8.7.5",
    "scripts": {
        "installFE": "pnpm --filter frontend install",
        "installBE": "pnpm --filter backend install",
        "installAll": "pnpm installFE && pnpm installBE",
        "devAll": "pnpm devFE && pnpm devBE",
        "devFE": "pnpm --filter frontend dev",
        "devBE": "pnpm --filter backend run dev",
        "prodBE": "pnpm --filter backend run prod",
        "prodFE": "pnpm --filter frontend run prod"
    },
    "pnpm": {
        "patchedDependencies": {
            "node-tls-client@2.1.0": "patches/node-tls-client@2.1.0.patch"
        },
        "overrides": {
            "proxy-addr": "^2.0.8",
            "body-parser@2": "^2.4.0",
            "fast-uri@3": "^3.1.8",
            "form-data@4": "^4.0.6",
            "ip-address@10": "^10.3.1",
            "qs@6": "^6.15.2",
            "hono@4": "^4.12.34",
            "@hono/node-server@1": "^1.19.15",
            "piscina@5": "^5.3.2",
            "undici@7": "^7.28.0",
            "protobufjs@7": "^7.5.5",
            "axios@1": "^1.15.1",
            "fast-xml-parser@5": "^5.10.1",
            "@grpc/grpc-js@1": "^1.14.5",
            "@fastify/busboy@3": "^3.2.1",
            "nanoid@3": "^3.3.16",
            "postcss@8": "^8.5.12",
            "source-map-js@1": "^1.2.2"
        }
    }
}
