FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# App configuration
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_ROOT_DOMAIN=
