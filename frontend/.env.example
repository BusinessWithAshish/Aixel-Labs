# MongoDB Configuration
MONGODB_URI=
MONGODB_DB_NAME=

# Backend configuration
# AIXEL_API_SECRET: server-only, sent on every backend call; must match the backend's value.
AIXEL_API_SECRET=
BE_API=

NODE_ENV=

# Next.js Configuration
NEXT_PUBLIC_NODE_ENV=
NEXT_PUBLIC_SKIP_DEVICE_FINGERPRINT=

# Firebase client (public) — fill from Firebase console project settings
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only) — from service account JSON
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# App configuration
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_ROOT_DOMAIN=
NEXT_PUBLIC_ROOT_URL=

# Feature flags (flags.ts): optional. 32 random bytes, base64url. Lets one browser override a flag
# through the `vercel-flag-overrides` cookie; without it no override applies.
FLAGS_SECRET=

# Landing page booking drawer webhook for landing page
NEXT_PUBLIC_AIXELLABS_BOOKING_CALL_WEBHOOK=

# File uploads (admin "drop a file locally -> lands on the VPS" feature)
# Unused on the frontend today: the backend mints/verifies upload tokens itself,
# the frontend only forwards the `init` call and carries the opaque token it returns.
AIXEL_UPLOAD_SECRET=
# Public origin of the VPS backend's upload routes (browser uploads directly here, bypassing the Next.js server)
NEXT_PUBLIC_BE_UPLOAD_ORIGIN=

# Big Business game (app/products/business): public WebSocket address of the backend,
# e.g. wss://api.example.com/business/ws. Leave empty in local dev: it is derived from BE_API.
NEXT_PUBLIC_BUSINESS_WS_URL=

# Voice agents: the voice engine (Python, phone.py). SECRET = the engine's VOICELAB_KEY.
VOICE_ENGINE_URL=https://voicelab.aixellabs.in
VOICE_ENGINE_SECRET=

# VoiceLink (Indian numbers). Its API refuses non-Indian IPs: route our calls through an Indian HTTP proxy.
VOICELINK_API_BASE=https://app.voicelink.co.in/api
VOICELINK_PROXY_URL=

# Twilio (customers bring their own account). Only tests change it, to point at a local fake.
TWILIO_API_BASE=https://api.twilio.com

# Gemini (customers bring their own API key; we check it before saving). Only tests change it.
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# Voice agents: customers' own booking apps (Google Calendar, Outlook, Cal.com, Calendly) through
# Composio's managed auth. Scoped project API key from dashboard.composio.dev (server only, never public):
# read on Tools and Toolkits, read + write on Session management, Connected accounts and Auth configs,
# write on Session tool execution. The voice engine uses its own key (sessions only, IP-allowlisted).
# Base defaults to https://backend.composio.dev/api/v3.1.
COMPOSIO_API_KEY=
COMPOSIO_API_BASE=
# Content Lab > Settings connects users' own YouTube / Instagram (read only) with the same key. Optional:
# auth configs made in the Composio dashboard with our own Google / Meta app; empty = Composio-managed auth.
COMPOSIO_AUTH_CONFIG_YOUTUBE=
COMPOSIO_AUTH_CONFIG_INSTAGRAM=
