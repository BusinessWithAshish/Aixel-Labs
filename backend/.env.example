# MongoDB Configuration
MONGODB_URI=
MONGODB_DB_NAME=

# Server Configuration
PORT=
NODE_ENV=
RATE_LIMIT_MAX=

# Google API keys
GOOGLE_MAPS_PLACES_API_KEY='a'
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
GEMINI_API_KEY=
GEMINI_API_KEY_FREE=

# Browser worker backend configuration URL
SCRAPER_URL=

# Proxy configs
EVOMI_PROXY_USERNAME=
EVOMI_PROXY_PASSWORD=
EVOMI_PROXY_HOST=
EVOMI_PROXY_PORT=

# Transcription (Groq speech-to-text)
GROQ_API_KEY=

# VPS runtime flags — leave unset on Vercel and local dev.
# AIXEL_VPS=1 gates the chatgpt (headful Chrome/CDP) and claude (shells to
# the local CLI) modules to this one host; both refuse to run without it.
AIXEL_VPS=
AIXEL_MEDIA_ROOT=
AIXEL_MEDIA_PUBLIC_BASE=
# ChatGPT accounts by name, JSON — see src/api/chatgpt/README.md#accounts.
# Unset = one "default" account on CHATGPT_PROFILE_DIR / CHATGPT_CODEX_HOME.
CHATGPT_ACCOUNTS=
# Account used when a call names none (one of the CHATGPT_ACCOUNTS names).
CHATGPT_DEFAULT_ACCOUNT=
# Folder of per-channel key files (<slug>.json: {"gemini": "...", "groq": "..."}),
# outside the repo. Unset = every call uses the shared keys above.
CHANNEL_API_KEYS_DIR=
# media op=narrate provider "kokoro": URL of the self-hosted Kokoro TTS server.
KOKORO_URL=

# HMAC secret for the media-upload (chunked local-file upload) token — see
# api/media/upload/. Shared with the frontend's server-only env (NOT
# NEXT_PUBLIC_*), since the frontend signs/relays the same token scheme.
AIXEL_UPLOAD_SECRET=

# Shared secret every remote caller must present (`x-aixel-api-key` header,
# `Authorization: Bearer`, or `/mcp?key=` for hosted MCP connectors). Callers on
# this host (127.0.0.1) are exempt. Unset = the whole API is open: local dev only.
# Must match the frontend's AIXEL_API_SECRET. Generate: openssl rand -hex 32
AIXEL_API_SECRET=

